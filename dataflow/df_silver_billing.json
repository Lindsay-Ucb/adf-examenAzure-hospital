{
	"name": "df_silver_billing",
	"properties": {
		"folder": {
			"name": "Silver"
		},
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "Bronze_billing_sql",
						"type": "DatasetReference"
					},
					"name": "billing"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "Silver_billing_sql",
						"type": "DatasetReference"
					},
					"name": "sink1"
				}
			],
			"transformations": [
				{
					"name": "derivedColumn1"
				},
				{
					"name": "derivedColumn2"
				},
				{
					"name": "filter1"
				},
				{
					"name": "cast1"
				}
			],
			"scriptLines": [
				"source(output(",
				"          billing_id as string,",
				"          admission_id as string,",
				"          charge_type as string,",
				"          amount as string,",
				"          payment_status as string,",
				"          payment_date as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     query: 'SELECT b.*\\nFROM bronze.billing b\\nWHERE TRY_CAST(b.admission_id AS INT) IN (SELECT admission_id FROM silver.admissions)',",
				"     format: 'query') ~> billing",
				"billing derive(billing_id = toInteger(toString(billing_id)),",
				"          admission_id = toInteger(toString(admission_id)),",
				"          charge_type = trim(toString(charge_type)),",
				"          amount = toDecimal(replace(replace(toString(amount), '$', ''), ',', ''), 12, 2),",
				"          payment_status = upper(trim(toString(payment_status)))) ~> derivedColumn1",
				"derivedColumn1 derive(payment_date = coalesce(     toDate(toString(payment_date), 'yyyy-MM-dd'),     toDate(toString(payment_date), 'MM-dd-yyyy'),     toDate(toString(payment_date), 'dd-MMM-yyyy'),     toDate(toString(payment_date)) )) ~> derivedColumn2",
				"cast1 filter(!isNull(billing_id) && !isNull(admission_id) && !isNull(amount) && !isNull(charge_type) && !isNull(payment_status)) ~> filter1",
				"derivedColumn2 cast(output(",
				"          amount as decimal(10,0) '000,000,000.000',",
				"          payment_date as date 'yyyy/MM/dd'",
				"     ),",
				"     errors: true) ~> cast1",
				"filter1 sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     input(",
				"          billing_id as integer,",
				"          admission_id as integer,",
				"          charge_type as string,",
				"          amount as decimal(12,2),",
				"          payment_status as string,",
				"          payment_date as date",
				"     ),",
				"     deletable:false,",
				"     insertable:true,",
				"     updateable:false,",
				"     upsertable:false,",
				"     format: 'table',",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     errorHandlingOption: 'stopOnFirstError') ~> sink1"
			]
		}
	}
}