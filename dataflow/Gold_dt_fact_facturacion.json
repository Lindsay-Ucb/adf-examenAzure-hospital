{
	"name": "Gold_dt_fact_facturacion",
	"properties": {
		"folder": {
			"name": "Gold"
		},
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "Silver_billing_sql",
						"type": "DatasetReference"
					},
					"name": "factFacturacion"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "Gold_fact_facturacion",
						"type": "DatasetReference"
					},
					"name": "sink1"
				}
			],
			"transformations": [],
			"scriptLines": [
				"source(output(",
				"          billing_id_bk as integer,",
				"          admission_id_bk as integer,",
				"          paciente_key as integer,",
				"          departamento_key as integer,",
				"          servicio_cargo_key as integer,",
				"          fecha_pago_key as integer,",
				"          monto_facturado as decimal(12,2),",
				"          conteo_transacciones as integer",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     query: 'SELECT b.billing_id AS billing_id_bk, b.admission_id AS admission_id_bk,\\n  pk.paciente_key, dk.departamento_key, sk.servicio_cargo_key,\\n  fp.fecha_key AS fecha_pago_key, b.amount AS monto_facturado, 1 AS conteo_transacciones\\nFROM silver.billing b\\nJOIN silver.admissions a ON a.admission_id = b.admission_id\\nJOIN gold.dim_paciente pk ON pk.patient_id_bk = a.patient_id\\nJOIN gold.dim_departamento dk ON dk.nombre_departamento = a.department\\nJOIN gold.dim_servicio_cargo sk ON sk.tipo_cargo = b.charge_type AND sk.estado_pago = b.payment_status\\nLEFT JOIN gold.dim_fecha fp ON fp.fecha_key = CONVERT(INT, FORMAT(b.payment_date,\\'yyyyMMdd\\'))',",
				"     format: 'query') ~> factFacturacion",
				"factFacturacion sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     input(",
				"          facturacion_key as long,",
				"          billing_id_bk as integer,",
				"          admission_id_bk as integer,",
				"          paciente_key as integer,",
				"          departamento_key as integer,",
				"          servicio_cargo_key as integer,",
				"          fecha_pago_key as integer,",
				"          monto_facturado as decimal(12,2),",
				"          conteo_transacciones as integer",
				"     ),",
				"     deletable:false,",
				"     insertable:true,",
				"     updateable:false,",
				"     upsertable:false,",
				"     format: 'table',",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     errorHandlingOption: 'allErrors',",
				"     transactionCommit: 'single',",
				"     reportSuccessOnError: false,",
				"     mapColumn(",
				"          billing_id_bk,",
				"          admission_id_bk,",
				"          paciente_key,",
				"          departamento_key,",
				"          servicio_cargo_key,",
				"          fecha_pago_key,",
				"          monto_facturado,",
				"          conteo_transacciones",
				"     )) ~> sink1"
			]
		}
	}
}