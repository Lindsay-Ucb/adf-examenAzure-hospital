{
	"name": "Gold_df_dim_paciente",
	"properties": {
		"folder": {
			"name": "Gold"
		},
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "Silver_patients_sql",
						"type": "DatasetReference"
					},
					"name": "dimPaciente"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "Gold_dim_paciente",
						"type": "DatasetReference"
					},
					"name": "sink1"
				}
			],
			"transformations": [],
			"scriptLines": [
				"source(output(",
				"          patient_id_bk as integer,",
				"          nombre_completo as string,",
				"          genero as string,",
				"          fecha_nacimiento as date,",
				"          rango_etario as string,",
				"          correo_electronico as string,",
				"          direccion as string,",
				"          proveedor_seguro as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     query: 'SELECT p.patient_id AS patient_id_bk, p.full_name AS nombre_completo,\\n  CASE p.gender WHEN \\'M\\' THEN \\'Masculino\\' WHEN \\'F\\' THEN \\'Femenino\\' ELSE \\'Otro\\' END AS genero,\\n  p.date_of_birth AS fecha_nacimiento,\\n  CASE WHEN p.date_of_birth IS NULL THEN NULL\\n       WHEN e.edad <= 18 THEN \\'0-18\\' WHEN e.edad <= 35 THEN \\'19-35\\'\\n       WHEN e.edad <= 60 THEN \\'36-60\\' ELSE \\'60+\\' END AS rango_etario,\\n  p.email AS correo_electronico, p.address AS direccion,\\n  ISNULL(p.insurance_provider,\\'Sin Seguro\\') AS proveedor_seguro\\nFROM silver.patients p\\nCROSS APPLY (SELECT DATEDIFF(YEAR,p.date_of_birth,GETDATE())\\n  - CASE WHEN (MONTH(p.date_of_birth)*100+DAY(p.date_of_birth))\\n         > (MONTH(GETDATE())*100+DAY(GETDATE())) THEN 1 ELSE 0 END AS edad) e',",
				"     format: 'query') ~> dimPaciente",
				"dimPaciente sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     input(",
				"          paciente_key as integer,",
				"          patient_id_bk as integer,",
				"          nombre_completo as string,",
				"          genero as string,",
				"          fecha_nacimiento as date,",
				"          rango_etario as string,",
				"          correo_electronico as string,",
				"          direccion as string,",
				"          proveedor_seguro as string",
				"     ),",
				"     deletable:false,",
				"     insertable:true,",
				"     updateable:false,",
				"     upsertable:false,",
				"     format: 'table',",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     errorHandlingOption: 'allErrors',",
				"     transactionCommit: 'single',",
				"     reportSuccessOnError: false) ~> sink1"
			]
		}
	}
}